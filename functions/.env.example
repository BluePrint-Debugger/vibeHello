# Copy this file to functions/.env and fill in your real Agora App ID
# before deploying. This value isn't secret (it's already public in the
# Flutter app's AgoraConstants.appId), so a plain .env param is fine -
# only the App Certificate needs to go through Secret Manager.
AGORA_APP_ID=96ce746126aa481c98cd394db7e1413a

# --- iOS VoIP calling (CallKit/PushKit) ---
# From Apple Developer > Certificates, Identifiers & Profiles > Keys.
# Not secret by themselves - just identifiers, not the actual key file.
APNS_KEY_ID=
APNS_TEAM_ID=
# Your app's bundle id, e.g. com.example.vibehello - VoIP pushes use the
# topic "<bundle-id>.voip".
IOS_BUNDLE_ID=

# The APNs Auth Key itself (contents of the .p8 file) is NOT set here -
# it's a real secret, set separately with:
#   firebase functions:secrets:set APNS_AUTH_KEY
